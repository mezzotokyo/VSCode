{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (iride)",
      "options": {
        "baseURL": "http://iride.local:11434/v1"
      },
      "models": {
        "iride:technical_auditor": {
          "name": "Iride Technical Auditor (Review)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "iride:expert_engineer": {
          "name": "Iride Expert Engineer (Coding)",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "temperature": 0,
            "presence_penalty": 0
          }
        },
        "iride:ethical_architect": {
          "name": "Iride Ethical Architect (Analysis)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5:9b-nvfp4": {
          "name": "Qwen3.5",
          "limit": {
            "context": 4096,
            "output": 8192
          }
        },
        "gemma4:12b-nvfp4": {
          "name": "Gemma4",
          "limit": {
            "context": 4096,
            "output": 8192
          }
        },
        "granite4.1:3b": {
          "name": "Granite 3B (Light Weight)",
          "limit": {
            "context": 4096,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "opencode/bigpickle",
  "small_model": "ollama/granite4.1:3b"
}
